# Environment Variables for LocateMeAI

# ==========================================
# LOCAL DEVELOPMENT (without Docker)
# ==========================================

# Backend Configuration (Local)
BACKEND_URL=http://localhost:8000

FRONTEND_AUTH_ENABLED=true
FRONTEND_AUTH_USERS=alice:password123,bob:password456

# Optional: simple frontend login for a few known users
# FRONTEND_AUTH_ENABLED=true
# FRONTEND_AUTH_USERS=alice:change-me,bob:change-me-too

# Optional: File Upload Limits
MAX_UPLOAD_SIZE=100MB

# ==========================================