# Environment Variables for LocateMeAI - Docker Deployment
# This file is used by docker-compose.yml

# ==========================================
# DOCKER DEPLOYMENT
# ==========================================

# Backend Configuration (Docker)
# When running in Docker, backend service is accessible via service name
BACKEND_URL=http://backend:8000

FRONTEND_AUTH_ENABLED=true
FRONTEND_AUTH_USERS=alice:password123,bob:password456

# Optional: simple frontend login for a few known users
# FRONTEND_AUTH_ENABLED=true
# FRONTEND_AUTH_USERS=alice:change-me,bob:change-me-too

MAX_UPLOAD_SIZE=100MB
# ==========================================