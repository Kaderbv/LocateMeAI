# Environment Variables for LocateMeAI

# ==========================================
# LOCAL DEVELOPMENT (without Docker)
# ==========================================
# Use these settings when running with:
# - Backend: uvicorn app.main:app --reload
# - Frontend: streamlit run app.py
# Copy to .env.local and source it

# Backend Configuration (Local)
BACKEND_HOST=localhost
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# Frontend Configuration (Local)
FRONTEND_HOST=localhost
FRONTEND_PORT=8501
# Optional: enable simple frontend login for a few known users
# FRONTEND_AUTH_ENABLED=true
# FRONTEND_AUTH_USERS=alice:change-me,bob:change-me-too

# Ollama Configuration (Local)
OLLAMA_HOST=http://localhost:11434

# ==========================================
# DOCKER DEPLOYMENT
# ==========================================
# Use these settings when running with docker compose
# Copy to .env and use with docker compose

# Backend Configuration (Docker)
# When running in Docker, backend service is accessible via service name
BACKEND_URL=http://backend:8000

# Ollama Configuration (Docker)
# Use host.docker.internal to access Ollama running on host machine
OLLAMA_HOST=http://host.docker.internal:11434
# If running Ollama in Docker container, uncomment below:
# OLLAMA_HOST=http://ollama:11434

# ==========================================
# PRODUCTION EC2 DEPLOYMENT
# ==========================================
# Use these settings when deploying to EC2

# Backend Configuration (Production)
# BACKEND_HOST=0.0.0.0
# BACKEND_PORT=8000
# BACKEND_URL=http://your-ec2-public-ip:8000

# Frontend Configuration (Production)
# FRONTEND_HOST=0.0.0.0
# FRONTEND_PORT=8501
# Optional: enable simple frontend login for a few known users
# FRONTEND_AUTH_ENABLED=true
# FRONTEND_AUTH_USERS=alice:change-me,bob:change-me-too

# Ollama Configuration (Production)
# OLLAMA_HOST=http://localhost:11434

# ==========================================
# SHARED CONFIGURATION
# ==========================================

# Optional: Model Configuration
DEFAULT_YOLO_MODEL=yolov8n.pt
OLLAMA_MODEL_NAME=llava

# Optional: File Upload Limits
MAX_UPLOAD_SIZE=100MB
