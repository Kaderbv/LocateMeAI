# Environment Variables for LocateMeAI - Docker Deployment
# This file is used by docker-compose.yml

# ==========================================
# DOCKER DEPLOYMENT
# ==========================================

# Ollama Configuration (Docker)
# For Linux: Use host.docker.internal (add --add-host to docker run) or use bridge IP
# For Mac/Windows: host.docker.internal works by default
# For Ollama on host machine (Linux): Use http://172.17.0.1:11434 (docker0 bridge IP)
# If running Ollama in Docker container, use: http://ollama:11434
OLLAMA_HOST=http://172.17.0.1:11434

# YOLO Model Configuration
DEFAULT_YOLO_MODEL=yolov8n.pt
OLLAMA_MODEL_NAME=llava

# Optional: File Upload Limits
MAX_UPLOAD_SIZE=100MB

# ==========================================

